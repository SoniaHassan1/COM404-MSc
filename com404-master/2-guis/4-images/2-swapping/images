from tkinter import*

class Gui(Tk):
    def __init__(self):
        super().__init__()

        #load resources
        self.cactus_image = PhotoImage(file="plane.gif")
        self.name_image = PhotoImage(file="bike.gif")
        
        
        #set window attributes
        self.title("Gui")


        #add components
        self.add_heading_label()
        self.add_cactus_image_label()
        self.add_button()
        
        
    def add_heading_label(self):
        self.heading_label = Label()
        self.heading_label.grid(row=0, column=0, columnspan=1)
        self.heading_label.configure(font= "Arial 20", text="Cactus Leaves")

    def add_cactus_image_label(self):
        self.cactus_image_label = Label()
        self.cactus_image_label.grid(row=1 , column=0)
        self.cactus_image_label.configure(image=self.cactus_image,
                                             height=100,
                                             width=100)
        
        
    def add_button(self):
        self.add_button = Button()
        self.add_button.grid(row=2, column=0)
        self.add_button.configure(text="Flip")


        #bind events
        self.add_button.bind("<ButtonRelease-1>", self.left_clicked)
        self.add_button.bind("<ButtonRelease-3>", self.right_clicked)


    def left_clicked(self, event):
        self.cactus_image_label.configure(image=self.cactus_image)
        print("left ")

    def right_clicked(self, event):
        self.cactus_image_label.configure(image=self.name_image)
        print("right")
        
    
     
